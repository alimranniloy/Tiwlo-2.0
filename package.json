{
  "name": "tiwlo-stockpro",
  "version": "1.0.0",
  "description": "StockPro Inventory Management System",
  "private": true,
  "scripts": {
    "prestart": "node server/scripts/ensureDeps.js",
    "start": "node server/server.js",
    "client": "npm --prefix client run dev",
    "server": "npm --prefix server start",
    "pm2:start": "pm2 startOrReload ecosystem.config.cjs --update-env && pm2 save",
    "pm2:restart": "pm2 restart tiwlo-backend --update-env",
    "pm2:status": "pm2 status",
    "rust:check": "cargo check --manifest-path server/rust-backend/Cargo.toml",
    "rust:run": "cargo run --manifest-path server/rust-backend/Cargo.toml",
    "dev": "concurrently \"npm run rust:run\" \"npm run server\" \"npm run client\"",
    "build": "npm --prefix client run build",
    "docker:up": "docker-compose -f docker/docker-compose.yml up -d",
    "docker:down": "docker-compose -f docker/docker-compose.yml down",
    "docker:db": "docker-compose -f docker/docker-compose.yml up -d postgres pgadmin",
    "install:all": "npm install && npm --prefix server install && npm --prefix client install",
    "deploy:production": "bash ./deploy-production.sh",
    "deploy:live": "bash ./deploy-production.sh",
    "deploy:rust": "bash ./deploy-production.sh --rust-only",
    "setup:ubuntu": "bash ./ops/ubuntu24/bootstrap.sh --dry-run",
    "setup:ubuntu:apply": "sudo bash ./ops/ubuntu24/bootstrap.sh --apply"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
