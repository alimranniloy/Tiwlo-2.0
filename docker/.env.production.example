# This file contains Docker-only database credentials.
# Shared domains and server settings come from the repository-root .env.
POSTGRES_USER=tiwlo
POSTGRES_DB=tiwlo_master
# Generate a long random password; deploy-production.sh does this automatically.
POSTGRES_PASSWORD=change-this-before-production
REDIS_PASSWORD=replace-with-a-long-random-password
TIWLO_RUST_RATE_LIMIT=120
TIWLO_RUST_MAX_BODY_BYTES=1048576
TIWLO_INTERNAL_IDENTITY_SECRET=replace-with-a-long-random-internal-secret
TIWLO_RUST_BACKEND_URL=http://rust:7100
TIWLO_RUST_DOMAIN_CLAIM_ENABLED=false
