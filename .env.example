# Shared Tiwlo web/server configuration.
# Copy this file to .env. Keep secrets and deployment-specific credentials out of Git.
VITE_PRIMARY_DOMAIN=tiwlo.com
# Leave blank to use VITE_PRIMARY_DOMAIN for free store subdomains.
VITE_STORE_DOMAIN=
VITE_SERVER_IPV4=162.35.124.233
VITE_WWW_SUBDOMAIN=www
VITE_AUTH_SUBDOMAIN=auth
VITE_TPANEL_SUBDOMAIN=tpanel
VITE_DNS1_SUBDOMAIN=dns1
VITE_DNS2_SUBDOMAIN=dns2
VITE_MAIL_SUBDOMAIN=mail
VITE_SUPPORT_EMAIL_LOCAL_PART=support
VITE_ADMIN_EMAIL_LOCAL_PART=admin
VITE_BILLING_EMAIL_LOCAL_PART=billing
VITE_NOREPLY_EMAIL_LOCAL_PART=noreply
VITE_SECURITY_EMAIL_LOCAL_PART=security
VITE_DNS_TTL=300
VITE_DNS_NS_TTL=86400
VITE_DNS_SOA_TTL=3600
VITE_DNS_DMARC_POLICY=quarantine
VITE_DNS_SPF_POLICY=~all
VITE_DKIM_SELECTOR=tiwlo
VITE_SSL_EMAIL_LOCAL_PART=support
VITE_EMAIL_SENDER_NAME=Tiwlo
SSL_PROVIDER=nginx

# SMTP credentials stay server-side and are never prefixed with VITE_.
SMTP_PROVIDER=local_postfix
SMTP_HOST=127.0.0.1
SMTP_PORT=25
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_TLS_REJECT_UNAUTHORIZED=true

# Server-side AI and application signing secrets. Generate unique random values.
GEMINI_API_KEY=
SECURITY_SECRET=
SECURITY_HMAC_SECRET=
TIWI_APP_TRUST_KEY=

# Payment provider placeholders for future server-side integrations.
# Do not add VITE_ prefixes to private keys or secrets.
STRIPE_MODE=test
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
BKASH_MODE=sandbox
BKASH_BASE_URL=
BKASH_APP_KEY=
BKASH_APP_SECRET=
BKASH_USERNAME=
BKASH_PASSWORD=
NAGAD_MODE=sandbox
NAGAD_BASE_URL=
NAGAD_MERCHANT_ID=
NAGAD_MERCHANT_NUMBER=
NAGAD_MERCHANT_PRIVATE_KEY=
NAGAD_MERCHANT_PUBLIC_KEY=
SSLCOMMERZ_MODE=sandbox
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
